{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "astromatic",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}